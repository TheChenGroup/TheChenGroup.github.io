---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  photo: ImageMetadata;
}

const { photo } = Astro.props;
---

<div class="photo-container">
  <Image class="background" src={photo} width={100} alt="" loading="eager" />
  <div class="photo-inner">
    <Image
      class="group-photo"
      src={photo}
      alt=""
      width={1200}
      densities={[1.5, 2]}
      loading="eager"
    />
    <div class="title">Ji Chen's Group</div>
  </div>
</div>

<style>
  .photo-container {
    overflow: hidden;
    position: relative;
    background-color: #aaa;
    display: flex;
    justify-content: center;
    align-items: center;

    /* Make it full width */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    margin-bottom: 4rem;
  }

  .photo-inner {
    display: flex;
    max-width: 100vw;
    max-height: 65vh;
    position: relative;
    z-index: 1;
  }

  img.group-photo {
    max-height: 65vh;
    max-width: 100vw;
    height: 100%;
    width: auto;
  }

  .background {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);

    /* blur is ugly without padding */
    width: calc(100% + 100px);
    height: 100%;
    object-fit: cover;
    left: -50px;
    filter: blur(20px);
  }

  .title {
    position: absolute;
    width: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-size: 2.5rem;
    line-height: 2em;
    background-color: rgb(0 0 0 / 50%);
    color: white;
    text-align: center;
    font-weight: bold;
    opacity: 1;
    transition: all linear 500ms;
  }

  .photo-container:hover .title {
    opacity: 0;
  }
</style>
