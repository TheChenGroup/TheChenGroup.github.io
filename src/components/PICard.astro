---
import { Image } from "astro:assets";
import { getImageMetadata } from "../images";
import type { ImageMetadata } from "astro";

interface Props {
  image: string | ImageMetadata;
}

const image = await getImageMetadata(Astro.props.image);
---

<div class="pi-card">
  <Image src={image} alt="" loading="eager" />
  <div class="pi-description">
    <slot />
  </div>
</div>

<style>
  .pi-card {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  img {
    border-radius: 10px;
    flex-basis: 10rem;
    width: 100%;
    height: 100%;
  }

  .pi-description {
    flex-basis: 20rem;
    flex-grow: 2;
  }
</style>
